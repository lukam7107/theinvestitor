---
import '../styles/global.css';
import StockTicker from '../components/StockTicker.astro';

interface Props {
  title: string;
  description?: string;
  showTicker?: boolean;
}

const { title, description = 'Poglobljene analize delnic v slovenščini — brez šuma, brez hype-a.', showTicker = true } = Astro.props;
---
<!doctype html>
<html lang="sl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — TheInvestitor</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {showTicker && <StockTicker />}
    <nav class="nav">
      <div class="wrap">
        <a class="brand" href="/">the<span>investitor</span></a>
        <div class="links">
          <a href="/analize">Analize</a>
          <a href="/kalkulator">Kalkulator</a>
          <a href="/o-projektu">O projektu</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        © {new Date().getFullYear()} TheInvestitor. Vsebina je informativne narave in ne predstavlja investicijskega nasveta.
      </div>
    </footer>
  </body>
</html>
