---
// Deterministični sparkline graf — generiran iz tickerja (seed),
// da je za vsako delnico vedno enak. Trend (gor/dol) določa barvo.
interface Props {
  seed: string;
  up?: boolean;
  width?: number;
  height?: number;
}

const { seed, up = true, width = 260, height = 56 } = Astro.props;

// preprost seeded PRNG iz stringa
function hash(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
let state = hash(seed);
function rnd(): number {
  state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
  return state / 4294967296;
}

const n = 28;
const drift = up ? 0.55 : -0.55;
let v = 50;
const values: number[] = [];
for (let i = 0; i < n; i++) {
  v += (rnd() - 0.5) * 14 + drift;
  values.push(v);
}
const min = Math.min(...values);
const max = Math.max(...values);
const pad = 4;
const pts = values.map((val, i) => {
  const x = pad + (i / (n - 1)) * (width - 2 * pad);
  const y = pad + (1 - (val - min) / (max - min || 1)) * (height - 2 * pad);
  return [x, y] as const;
});
const line = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `${pad},${height} ${line} ${(width - pad).toFixed(1)},${height}`;
const color = up ? '#2fe08a' : '#ff5c72';
const gid = `g-${hash(seed).toString(36)}`;
const [lx, ly] = pts[pts.length - 1];
---
<svg
  viewBox={`0 0 ${width} ${height}`}
  width="100%"
  height={height}
  preserveAspectRatio="none"
  aria-hidden="true"
  style="display: block;"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={color} stop-opacity="0.22" />
      <stop offset="100%" stop-color={color} stop-opacity="0" />
    </linearGradient>
  </defs>
  <polygon points={area} fill={`url(#${gid})`} />
  <polyline
    points={line}
    fill="none"
    stroke={color}
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx={lx} cy={ly} r="3" fill={color} />
</svg>
