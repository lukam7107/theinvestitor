---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kontakt" description="Kontaktiraj TheInvestitor — vprašanja, predlogi delnic za analizo ali poslovna povpraševanja.">
  <h1>Kontakt</h1>
  <p class="contact-intro">
    Vprašanje o analizi, predlog delnice, povratna informacija ali poslovno
    povpraševanje — piši kadarkoli, odgovorimo osebno.
  </p>

  <a class="contact-card" href="mailto:info@theinvestitor.com">
    <span class="contact-icon">✉</span>
    <span>
      <span class="contact-label">Piši na</span>
      <span class="contact-email mono">info@theinvestitor.com</span>
    </span>
  </a>

  <p class="contact-note">
    Predlagaš delnico za analizo? Vsak predlog upoštevamo pri načrtovanju
    naslednjih analiz — glej tudi <a href="/faq">FAQ</a>.
  </p>
</Layout>
