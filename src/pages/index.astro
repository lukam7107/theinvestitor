---
import Layout from '../layouts/Layout.astro';
import Sparkline from '../components/Sparkline.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getCollection } from 'astro:content';

const analize = (await getCollection('analize')).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()
);
---
<Layout title="Domov" showTicker={true}>
  <section class="hero-split">
    <div class="hero">
      <span class="eyebrow">Delniške analize v slovenščini</span>
      <h1>Beri, preden kupiš. <em>Ne šele, ko izgubiš.</em></h1>
      <p class="lead">
        Medtem ko večina lovi nasvete na družbenih omrežjih, mi beremo bilance.
        TheInvestitor prinaša poglobljene analize delnic v slovenščini za slovenske
        in balkanske retail investitorje — poslovni model, številke, bull &amp; bear
        scenariji in naša ocena poštene vrednosti. Brez senzacionalizma, brez
        sponzoriranih priporočil.
      </p>
    </div>
    <div class="hero-chart" aria-hidden="true">
      <svg viewBox="0 0 500 300" width="100%" preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id="heroGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.4" />
            <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g stroke="rgba(255,255,255,0.08)" stroke-width="1">
          <line x1="0" y1="75" x2="500" y2="75" />
          <line x1="0" y1="150" x2="500" y2="150" />
          <line x1="0" y1="225" x2="500" y2="225" />
        </g>

        <line x1="0" y1="100" x2="500" y2="100" stroke="#8b5cf6" stroke-width="2" stroke-dasharray="6 6" opacity="0.75">
          <animate attributeName="opacity" values="0;0.75" dur="0.6s" begin="0.4s" fill="freeze" />
        </line>
        <text x="8" y="90" font-family="'JetBrains Mono', monospace" font-size="13" fill="#b7bcc6" opacity="0">
          fair value
          <animate attributeName="opacity" values="0;1" dur="0.6s" begin="0.4s" fill="freeze" />
        </text>

        <polygon
          points="0,300 0,230 45,215 90,240 135,190 180,205 225,155 270,170 315,125 360,140 405,90 450,105 500,50 500,300"
          fill="url(#heroGrad)"
          opacity="0"
        >
          <animate attributeName="opacity" values="0;0.9" dur="3.6s" fill="freeze" />
        </polygon>
        <polyline
          points="0,230 45,215 90,240 135,190 180,205 225,155 270,170 315,125 360,140 405,90 450,105 500,50"
          fill="none" stroke="#22d3ee" stroke-width="4"
          stroke-linecap="round" stroke-linejoin="round"
          stroke-dasharray="900" stroke-dashoffset="900"
        >
          <animate attributeName="stroke-dashoffset" from="900" to="0" dur="3.6s" fill="freeze" calcMode="spline" keySplines="0.25 0 0.3 1" />
        </polyline>

        <circle cx="500" cy="50" r="7" fill="#22d3ee" opacity="0">
          <animate attributeName="opacity" values="0;0;1" dur="3.6s" fill="freeze" />
          <animate attributeName="r" values="7;11;7" dur="1.8s" begin="3.6s" repeatCount="indefinite" />
        </circle>
        <circle cx="500" cy="50" r="7" fill="none" stroke="#22d3ee" stroke-width="2" opacity="0">
          <animate attributeName="r" values="7;22" dur="1.8s" begin="3.6s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0.6;0" dur="1.8s" begin="3.6s" repeatCount="indefinite" />
        </circle>
      </svg>
    </div>
  </section>

  <div class="section-title">
    <h2>Zadnje analize</h2>
  </div>
  <section class="card-grid">
    {analize.map((entry) => {
      const up = (entry.data.fairValueMin + entry.data.fairValueMax) / 2 >= entry.data.cena;
      return (
        <a class="card" href={`/analize/${entry.slug}`}>
          <div class="chip-row">
            <span class="chip ticker">{entry.data.ticker}</span>
            <span class="chip">{entry.data.borza}</span>
          </div>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.povzetek}</p>
          <div class="card-spark">
            <Sparkline seed={entry.data.ticker} up={up} />
          </div>
          <div class="card-meta">
            <span class="mono price">{entry.data.cena.toFixed(2)} {entry.data.valuta}</span>
            <span class={`mono fv ${up ? 'pos' : 'neg'}`}>
              FV {entry.data.fairValueMin}–{entry.data.fairValueMax} {entry.data.fairValueValuta}
            </span>
          </div>
        </a>
      );
    })}
  </section>

  <a href="/kalkulator" class="calc-promo">
    <div class="calc-promo-text">
      <span class="eyebrow">Moč obrestnoobrestnega računa</span>
      <h2>Kolikšna je cena čakanja?</h2>
      <p>Vnesi znesek, leta in donosnost — v realnem času vidiš, koliko bi lahko zraslo tvoje vlaganje.</p>
    </div>
    <span class="calc-promo-btn">Odpri kalkulator →</span>
  </a>

  <NewsletterForm />
</Layout>
